# Copy to .env for `netlify dev`, and set the same values in Netlify > Site settings > Environment variables.
# Never commit real values: this repo is public.

# Claude API key for the /api/andi proxy. Without it, Andi uses canned replies.
ANTHROPIC_API_KEY=

# n8n Workflow 1 webhook (lead intake + 60-second SMS). Without these, leads are kept in the browser only.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional: Cloudflare Turnstile secret. Also set window.ANDI_TURNSTILE_SITEKEY in public/index.html.
TURNSTILE_SECRET_KEY=

# Optional: lock the API to your site's origin, e.g. https://your-site.netlify.app
ALLOWED_ORIGIN=
