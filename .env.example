# Copy to .env for `netlify dev`, and set the same values in Netlify > Site settings > Environment variables.
# Never commit real values: this repo is public.

# Claude API key for the /api/andi proxy. Without it, Andi uses canned replies.
ANTHROPIC_API_KEY=

# Supabase leads database (server-only). Without these, leads aren't stored.
# Project URL from Supabase > Project Settings > API. Use a SECRET key (sb_secret_...),
# never the publishable/anon key, and never expose this value to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# n8n Workflow 1 webhook (lead intake + outreach). Without these, leads aren't forwarded.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional: Cloudflare Turnstile secret. Also set window.ANDI_TURNSTILE_SITEKEY in public/index.html.
TURNSTILE_SECRET_KEY=

# Optional: lock the API to your site's origin, e.g. https://your-site.netlify.app
ALLOWED_ORIGIN=
